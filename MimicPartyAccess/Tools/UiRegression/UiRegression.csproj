<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <MelonLoaderPath Condition="'$(MelonLoaderPath)' == ''">$(MimicPartyPath)\MelonLoader\net6</MelonLoaderPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\AccessibleMenuHandler.cs" Link="AccessibleMenuHandler.cs" />
    <Compile Include="..\..\ReflectionReader.cs" Link="ReflectionReader.cs" />
    <Compile Include="..\..\Loc.cs" Link="Loc.cs" />
    <Compile Include="..\..\ModLogger.cs" Link="ModLogger.cs" />
    <Reference Include="0Harmony">
      <HintPath>$(MelonLoaderPath)\0Harmony.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
